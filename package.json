{
  "name": "vision-paid-survey",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/VisionPaidSurvey/server/server.mjs",
    "build:ssr": "ng build && rename dist\\VisionPaidSurvey\\browser\\index.html index.csr.html",
    "copy-dist": "if exist functions\\dist rd /s /q functions\\dist && move dist functions\\dist",
    "deploy-all": "npm run build:ssr && npm run copy-dist && firebase deploy --only functions,hosting"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.1.2",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.1.0",
    "@angular/material": "^20.1.2",
    "@angular/platform-browser": "^20.1.0",
    "@angular/platform-server": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@angular/service-worker": "^20.3.5",
    "@angular/ssr": "^20.1.1",
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@ngu/carousel": "^20.0.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "angular-tabler-icons": "^3.26.0",
    "crypto-js": "^4.2.0",
    "express": "^5.1.0",
    "moment": "^2.30.1",
    "ng-recaptcha": "^13.2.1",
    "ngx-qrcode-styling": "^1.3.3",
    "ngx-scrollbar": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.1",
    "@angular/cli": "^20.1.1",
    "@angular/compiler-cli": "^20.1.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.19.9",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
