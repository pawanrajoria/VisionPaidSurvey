{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist/VisionPaidSurvey/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.html"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|woff2|ico|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "regex": "^/([a-z]{2}-[a-z]{2}/)?(surveyresult|survey|offerwall|app|admin)(/.*)?$",
        "destination": "/index.csr.html"
      },
      {
        "regex": "^/([a-z]{2}-[a-z]{2}/)?auth/(link|callback|paypalcallback)(/.*)?$",
        "destination": "/index.csr.html"
      },
      {
        "source": "**",
        "function": "ssr"
      }
    ]
  }
}